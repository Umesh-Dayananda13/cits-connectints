rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Admin gate used by content editor and admin reporting flows.
    // Future production change: move email allow-list to custom claims.
    function isVerifiedAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'csk07@gmail.com'
        ];
    }

    // Public site content is readable by everyone; only admins can write.
    match /siteContent/{document=**} {
      allow read: if true;
      allow write: if isVerifiedAdmin();
    }

    // Account profile documents used by signup + admin users table.
    match /users/{userId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == userId
        || request.auth.token.email == userId
        || isVerifiedAdmin()
      );
    }

    // Purchases are readable/writable by:
    // 1) owner uid path, 2) owner email path (legacy fallback), 3) admins.
    match /users/{userId}/purchases/{purchaseId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == userId
        || request.auth.token.email == userId
        || isVerifiedAdmin()
      );
    }
  }
}
